// Konfigurace electron-builderu — viz https://www.electron.build/configuration/configuration
{
  "appId": "com.hlsystem.app",
  "asar": true,
  "productName": "HLSystem",
  "directories": {
    "output": "release/${version}"
  },
  // Auto-update z GitHub Releases (viz electron/updater.ts). Pokladna si novou
  // verzi stáhne sama podle `latest.yml` — ten odkazuje na `hlsystem-app-win.exe`
  // (artifactName níž), jméno se proto nesmí měnit.
  // `draft`: CI release jen připraví; ke klientům se dostane až po ručním
  // „Publish release" na GitHubu — o načasování (např. přechod API) rozhoduje člověk.
  "publish": {
    "provider": "github",
    "owner": "cortequa",
    "repo": "hlsystem-app",
    "releaseType": "draft"
  },
  "forceCodeSigning": false,
  "files": [
    "dist",
    "dist-electron"
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "hlsystem-app-mac.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "hlsystem-app-win.${ext}",
    "verifyUpdateCodeSignature": false,
    "publisherName": "HLSystem"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  // Produkční pokladna (Fedora): updater čte `latest-linux.yml`, který odkazuje
  // na `hlsystem-app-linux.AppImage` — jméno se nesmí měnit.
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "hlsystem-app-linux.${ext}"
  }
}
