// Vývojová konfigurace electron-builder (bez auto-updater)
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.hlsystem.app.dev",
  "asar": true,
  "productName": "HLSystem (DEV)",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "hlsystem-app-mac-dev.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "hlsystem-app-win-dev.${ext}",
    "sign": null,
    "publisherName": "HLSystem Dev"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "hlsystem-app-linux-dev.${ext}"
  }
}
